<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tna</RootNamespace>
    <CodeAnalysisRuleSet>..\..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    型は結合した OpenAPI から、ビルドの中で作る (コミットしない)。運営者の API の型は名前空間と JSON のコンテキストを分け、
    画面に載せない。型のテンプレートを差し替えて、知らない項目の辞書を作らない (読むときは読み飛ばし、書き戻さない)。
    決まった形のない JSON は JsonElement にする
  -->
  <PropertyGroup>
    <OpenApiDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'docs', 'api', 'dist'))</OpenApiDirectory>
    <GeneratedDirectory>$(MSBuildProjectDirectory)\obj\generated\</GeneratedDirectory>
    <DtoTemplateDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'NSwagTemplates', 'Dto'))</DtoTemplateDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ContractsDocument Include="$(OpenApiDirectory)openapi.yaml">
      <Settings>nswag.json</Settings>
      <CodeFile>$(GeneratedDirectory)Contracts.g.cs</CodeFile>
      <Namespace>Tna.Contracts</Namespace>
      <ContextName>TnaJsonContext</ContextName>
      <ContextFile>$(GeneratedDirectory)TnaJsonContext.g.cs</ContextFile>
    </ContractsDocument>
    <ContractsDocument Include="$(OpenApiDirectory)ops-openapi.yaml">
      <Settings>nswag.ops.json</Settings>
      <CodeFile>$(GeneratedDirectory)OpsContracts.g.cs</CodeFile>
      <Namespace>Tna.Contracts.Ops</Namespace>
      <ContextName>TnaOpsJsonContext</ContextName>
      <ContextFile>$(GeneratedDirectory)TnaOpsJsonContext.g.cs</ContextFile>
    </ContractsDocument>
  </ItemGroup>

  <ItemGroup>
    <DtoTemplate Include="NSwagTemplates\Dto\*.liquid" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.MSBuild" Version="14.7.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 文書ごとに型を作る -->
  <Target Name="GenerateContracts"
          BeforeTargets="BeforeCompile;CoreCompile"
          Inputs="%(ContractsDocument.Identity);%(ContractsDocument.Settings);@(DtoTemplate);$(MSBuildProjectFullPath)"
          Outputs="%(ContractsDocument.CodeFile)">
    <MakeDir Directories="$(GeneratedDirectory)" />
    <Exec Command="$(NSwagExe_Net100) run %(ContractsDocument.Settings) &quot;/variables:Input=%(ContractsDocument.Identity),Output=%(ContractsDocument.CodeFile),TemplateDirectory=$(DtoTemplateDirectory.TrimEnd('\'))&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="low" />
  </Target>

  <!-- 文書のすべての型を載せた JSON のソース生成のコンテキスト。反射で読み書きしないため -->
  <Target Name="GenerateJsonContext"
          BeforeTargets="BeforeCompile;CoreCompile"
          AfterTargets="GenerateContracts"
          Inputs="%(ContractsDocument.CodeFile);$(MSBuildProjectFullPath)"
          Outputs="%(ContractsDocument.ContextFile)">
    <GenerateJsonContext SourceFile="%(ContractsDocument.CodeFile)" OutputFile="%(ContractsDocument.ContextFile)" Namespace="%(ContractsDocument.Namespace)" ContextName="%(ContractsDocument.ContextName)" />
  </Target>

  <!-- 生成が最新で飛ばされたときにも、生成したファイルをコンパイルに入れる -->
  <Target Name="IncludeGeneratedContracts" BeforeTargets="BeforeCompile;CoreCompile" AfterTargets="GenerateJsonContext">
    <ItemGroup>
      <Compile Remove="$(GeneratedDirectory)*.g.cs" />
      <Compile Include="@(ContractsDocument->'%(CodeFile)');@(ContractsDocument->'%(ContextFile)')" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="GenerateJsonContext" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <Namespace ParameterType="System.String" Required="true" />
      <ContextName ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = File.ReadAllText(SourceFile);
        var names = Regex.Matches(text, @"^\s*public (?:partial class|enum) (\w+)", RegexOptions.Multiline)
            .Cast<Match>()
            .Select(m => m.Groups[1].Value)
            .Distinct()
            .OrderBy(n => n, StringComparer.Ordinal)
            .ToList();
        var sb = new StringBuilder();
        sb.Append("// <auto-generated>Tna.Contracts.csproj が ").Append(Path.GetFileName(SourceFile)).Append(" から作った。</auto-generated>\r\n");
        sb.Append("namespace ").Append(Namespace).Append(";\r\n\r\n");
        sb.Append("[System.Text.Json.Serialization.JsonSourceGenerationOptions(UseStringEnumConverter = true, AllowOutOfOrderMetadataProperties = true)]\r\n");
        foreach (var name in names)
        {
            sb.Append("[System.Text.Json.Serialization.JsonSerializable(typeof(").Append(name).Append("))]\r\n");
        }
        sb.Append("public partial class ").Append(ContextName).Append(" : System.Text.Json.Serialization.JsonSerializerContext;\r\n");
        File.WriteAllText(OutputFile, sb.ToString(), new UTF8Encoding(false));
        Log.LogMessage(MessageImportance.Normal, "Generated " + ContextName + " with " + names.Count + " types.");
      ]]></Code>
    </Task>
  </UsingTask>

</Project>
